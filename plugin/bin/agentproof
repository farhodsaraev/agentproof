#!/bin/sh
# Start the Agentproof engine that matches this computer.
root="$(cd "$(dirname "$0")/.." && pwd)"

case "$(uname -s)-$(uname -m)" in
  # A release has the MSVC build. A local build in the Docker container has the GNU build.
  MINGW*-x86_64 | MSYS*-x86_64 | CYGWIN*-x86_64)
    target="x86_64-pc-windows-msvc/agentproof.exe"
    [ -x "$root/engine/$target" ] || target="x86_64-pc-windows-gnu/agentproof.exe" ;;
  Linux-x86_64) target="x86_64-unknown-linux-gnu/agentproof" ;;
  Linux-aarch64) target="aarch64-unknown-linux-gnu/agentproof" ;;
  Darwin-arm64) target="aarch64-apple-darwin/agentproof" ;;
  Darwin-x86_64) target="x86_64-apple-darwin/agentproof" ;;
  *) target="" ;;
esac

engine="$root/engine/$target"
if [ -z "$target" ] || [ ! -x "$engine" ]; then
  echo "Agentproof cannot start. There is no engine for this computer ($(uname -s) $(uname -m))." >&2
  exit 1
fi
exec "$engine" "$@"
